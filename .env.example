OPENAI_API_KEY=
# Optional: ADAMS Public Search API key (https://adams-api-developer.nrc.gov/). Public PDFs download without it.
ADAMS_API_KEY=
# "provider:model" or bare OpenAI name. Point JUDGE_MODEL at another provider for cross-family independence.
RAG_MODEL=gpt-5.6-sol
JUDGE_MODEL=gpt-5.6-sol
# OpenAI reasoning effort: medium is the project default.
KANON_REASONING_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-small
# Optional: only for models that accept it (GPT-5 reasoning models reject non-default values)
KANON_TEMPERATURE=
# Cross-encoder reranker over the top ~100 pre-filtered candidates. Empty = off (the default; see
# kanon/rerank.py). A HuggingFace repo id, e.g. BAAI/bge-reranker-v2-m3 (~2 GB on first search).
# A/B it before trusting it: uv run kanon-eval --modes none --rerank
KANON_RERANK_MODEL=
# Paid-request guards (kanon/ratelimit.py). Sliding window: at most this many model requests in
# any trailing 60 s, chat and embeddings together. 0 = no pacing.
KANON_MAX_REQUESTS_PER_MIN=300
# Hard budget for ONE process. The run stops with BudgetExceeded instead of draining the account;
# a full three-mode eval is ~1200 requests. 0 = no budget.
KANON_MAX_REQUESTS=1500
